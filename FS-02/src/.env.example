# Copy this file to .env for local Docker development. Replace all secrets.
POSTGRES_DB="collab_workspace"
POSTGRES_USER="collab"
POSTGRES_PASSWORD="change-this-local-password"
POSTGRES_PORT="5433"
DATABASE_URL="postgresql://collab:change-this-local-password@localhost:5433/collab_workspace?schema=public"
REDIS_PORT="6379"
REDIS_URL="redis://localhost:6379"

# Added in later phases; keep secrets out of source control.
API_PORT="4000"
JWT_SECRET="replace-with-a-random-secret-at-least-32-characters"
CORS_ORIGIN="http://localhost:5173"
DEMO_PASSWORD="set-a-local-demo-password"

# WebSocket server port
PORT=1234
NEXT_PUBLIC_WS_URL="ws://localhost:1234"
VITE_WS_URL="ws://localhost:1234"

# Optional SMTP email delivery (Phase 7). Uncomment and set all values to enable.
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER=""
# SMTP_PASSWORD=""
# SMTP_FROM="Collab Workspace <no-reply@example.com>"

# Next.js App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

